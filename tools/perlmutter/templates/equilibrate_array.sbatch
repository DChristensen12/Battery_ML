#!/bin/bash
#SBATCH --job-name={CAMPAIGN}
#SBATCH --account={PROJECT}
#SBATCH --qos={QOS}
#SBATCH --constraint=gpu
#SBATCH --nodes=1
#SBATCH --gpus={GPU_COUNT}
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=32
#SBATCH --time={TIME}
#SBATCH --array=1-{N_TASKS}%{MAX_CONCURRENT}
#SBATCH --output={CAMPAIGN_DIR}/%x_%a.out
#SBATCH --error={CAMPAIGN_DIR}/%x_%a.err

# ── SolvationNet batch equilibration on Perlmutter ──
# Generated by tools/perlmutter/perlmutter.py

set -euo pipefail

module load conda 2>/dev/null
conda activate {CONDA_ENV}

PROJECT_DIR="{PROJECT_DIR}"
CKPT_DIR="{PROJECT_DIR}/checkpoints"
MANIFEST="{MANIFEST_PATH}"

INPUT_FILE=$(sed -n "${{SLURM_ARRAY_TASK_ID}}p" "$MANIFEST")
if [ -z "$INPUT_FILE" ]; then
    echo "ERROR: No input file for array task $SLURM_ARRAY_TASK_ID"
    exit 1
fi

BOX_NAME=$(echo "$INPUT_FILE" | sed 's/_opt\.xyz//' | sed 's/\.xyz//')
INPUT_PATH="${{PROJECT_DIR}}/inputs/${{INPUT_FILE}}"

cd "${{PROJECT_DIR}}/electrolyte_toolkit"

echo "=== Task $SLURM_ARRAY_TASK_ID: $BOX_NAME ==="
echo "Started: $(date)"
echo "Node: $(hostname)"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || true

# Checkpoint-aware: resume if a checkpoint exists, otherwise start fresh
if [ -d "$CKPT_DIR/$BOX_NAME" ] && ls "$CKPT_DIR/$BOX_NAME"/ckpt_*.xyz 1>/dev/null 2>&1; then
    echo "Resuming from checkpoint: $BOX_NAME"
    python equilibrate.py --resume "$BOX_NAME" \
        --checkpoint-dir "$CKPT_DIR" \
        {EXTRA_ARGS}
else
    python equilibrate.py "$INPUT_PATH" \
        --checkpoint-dir "$CKPT_DIR" \
        --name "$BOX_NAME" \
        {EXTRA_ARGS}
fi

EQUIL_EXIT=$?

# NaN post-check: inspect the final structure for NaN positions
if [ $EQUIL_EXIT -eq 0 ]; then
    FINAL_XYZ="$CKPT_DIR/$BOX_NAME/$BOX_NAME.xyz"
    if [ -f "$FINAL_XYZ" ]; then
        python -c "
import numpy as np, sys
from ase.io import read
a = read('$FINAL_XYZ')
if np.any(np.isnan(a.get_positions())):
    print('NaN DETECTED in final structure: $BOX_NAME')
    sys.exit(42)
"
        NAN_EXIT=$?
        if [ $NAN_EXIT -eq 42 ]; then
            echo "Finished: $(date), NaN detected"
            exit 42
        fi
    fi
fi

echo "Finished: $(date), exit code: $EQUIL_EXIT"
exit $EQUIL_EXIT
