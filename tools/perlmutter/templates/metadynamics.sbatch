#!/bin/bash
#SBATCH --job-name={JOB_NAME}
#SBATCH --account={PROJECT}
#SBATCH --qos={QOS}
#SBATCH --constraint=gpu
#SBATCH --nodes={NODES}
#SBATCH --gpus={GPU_COUNT}
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=32
#SBATCH --time={TIME}
#SBATCH --output=slurm-%j.out
#SBATCH --error=slurm-%j.err

# ── Perlmutter GPU job: well-tempered metadynamics ──
# Generated by SolvationNet/tools/perlmutter/perlmutter.py

module load conda
conda activate {CONDA_ENV}

PROJECT_DIR="{PROJECT_DIR}"
INPUT_FILE="{INPUT_FILE}"
INPUT_PATH="${{PROJECT_DIR}}/inputs/${{INPUT_FILE}}"

cd "${{PROJECT_DIR}}/deep-shell"

echo "=== Metadynamics: ${{INPUT_FILE}} ==="
echo "Started: $(date)"
echo "Node: $(hostname)"
echo "GPU: $(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null || echo 'N/A')"

python la_metadynamics.py "${{INPUT_PATH}}" {EXTRA_ARGS}

echo "Finished: $(date)"
