#!/bin/bash
#SBATCH --job-name={CAMPAIGN}
#SBATCH --account={PROJECT}
#SBATCH --qos={QOS}
#SBATCH --constraint=gpu
#SBATCH --nodes=1
#SBATCH --gpus={GPU_COUNT}
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=32
#SBATCH --time={TIME}
#SBATCH --array=1-{N_TASKS}%{MAX_CONCURRENT}
#SBATCH --output={CAMPAIGN_DIR}/%x_%a.out
#SBATCH --error={CAMPAIGN_DIR}/%x_%a.err

# ── SolvationNet batch production MD on Perlmutter ──
# Generated by tools/perlmutter/perlmutter.py

set -euo pipefail

module load conda 2>/dev/null
conda activate {CONDA_ENV}

PROJECT_DIR="{PROJECT_DIR}"
CKPT_DIR="{PROJECT_DIR}/checkpoints"
PROJ_DIR="{PROJECT_DIR}/projects"
MANIFEST="{MANIFEST_PATH}"

INPUT_FILE=$(sed -n "${{SLURM_ARRAY_TASK_ID}}p" "$MANIFEST")
if [ -z "$INPUT_FILE" ]; then
    echo "ERROR: No input file for array task $SLURM_ARRAY_TASK_ID"
    exit 1
fi

BOX_NAME=$(echo "$INPUT_FILE" | sed 's/_opt\.xyz//' | sed 's/\.xyz//')
BOX_PROJECT="$PROJ_DIR/$BOX_NAME"

cd "${{PROJECT_DIR}}/electrolyte_toolkit"

echo "=== Task $SLURM_ARRAY_TASK_ID: $BOX_NAME (production MD) ==="
echo "Started: $(date)"
echo "Node: $(hostname)"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || true

# Set up project layout: use equilibrated structure as input
mkdir -p "$BOX_PROJECT/packed"
EQUIL_XYZ="$CKPT_DIR/$BOX_NAME/$BOX_NAME.xyz"
if [ -f "$EQUIL_XYZ" ]; then
    cp "$EQUIL_XYZ" "$BOX_PROJECT/packed/system.pdb"
else
    # Fall back to raw input
    cp "${{PROJECT_DIR}}/inputs/${{INPUT_FILE}}" "$BOX_PROJECT/packed/system.pdb"
fi

python run_md.py --project "$BOX_PROJECT" {EXTRA_ARGS}

echo "Finished: $(date), exit code: $?"
